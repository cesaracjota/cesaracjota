---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'books'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const data = entry.data;
const statusLabel = {
  finished: t('books.status.finished'),
  reading: t('books.status.reading'),
  'to-read': t('books.status.toRead'),
}[data.status];
const href = `/${lang}/books/${entry.id}/`;
---

<article class="book-card">
  <a class="book-card__cover" href={href} aria-label={`${t('books.readReview')}: ${data.title}`}>
    {data.cover ? <img src={data.cover} alt={`Portada de ${data.title}`} loading="lazy" width="240" height="320" /> : <div class="book-cover-fallback"><span>{data.title}</span><small>{data.author}</small></div>}
    <span class="book-card__status">{statusLabel}</span>
  </a>
  <div class="book-card__body">
    <p class="eyebrow">{data.author}</p>
    <h2><a href={href}>{data.title}</a></h2>
    <p>{data.description}</p>
    <div class="book-card__footer">
      <div class="tag-list" aria-label="Tags">
        {data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
      </div>
      <a class="text-link" href={href}>{t('books.readReview')} <Icon name="arrow-up-right" size="14" aria-hidden="true" /></a>
    </div>
  </div>
</article>
