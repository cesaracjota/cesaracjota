---
import ThemeToggle from './ThemeToggle.astro';
import { languages, useTranslations, type Lang } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';
import { identity } from '../data/profile';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = getLocalizedPath(lang);
const links = [
  ['about', lang === 'es' ? 'Inicio' : 'Home'],
  ['experience', lang === 'es' ? 'Experiencia' : 'Experience'],
  ['work', lang === 'es' ? 'Proyectos' : 'Projects'],
  ['research', lang === 'es' ? 'Intereses' : 'Interests'],
  ['courses', lang === 'es' ? 'Formación' : 'Training'],
  ['contact', t('nav.contact')],
];
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={home}><span class="brand__mark" aria-hidden="true">ca</span><span>{identity.name}</span></a>
    <div class="header-actions">
      <nav class="language-switcher" aria-label={t('nav.language')}>
        {Object.entries(languages).map(([code, label], i) => <>{i > 0 && <span aria-hidden="true">|</span>}<a data-astro-reload href={getLocalizedPath(code as Lang)} lang={code} hreflang={code} aria-label={label} aria-current={code === lang ? 'page' : undefined}>{code.toUpperCase()}</a></>)}
      </nav>
      <ThemeToggle lang={lang} />
    </div>
  </div>
  <nav class="site-nav" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
    {links.map(([id, label]) => <a href={home + '#' + id}>{label}</a>)}
  </nav>
</header>
