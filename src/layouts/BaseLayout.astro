---
import { ClientRouter } from 'astro:transitions';
import { identity, profiles } from '../data/profile';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocalizedPathFor } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  image = identity.avatar,
  type = 'website',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? Astro.url;
const siteName = identity.name;
const siteTitle = title ? `${title} — ${siteName}` : siteName;
const siteDescription = description ?? profiles[lang].intro;
const canonical = new URL(Astro.url.pathname, siteUrl);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteName,
  url: siteUrl.toString(),
  description: siteDescription,
  jobTitle: profiles[lang].role,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Arequipa',
    addressCountry: 'PE',
  },
  sameAs: [
    'https://github.com/cesaracjota',
    'https://www.linkedin.com/in/cesaracjota/',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f4" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="author" content={siteName} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(getLocalizedPathFor(Astro.url.pathname, 'es'), siteUrl)} />
    <link rel="alternate" hreflang="en" href={new URL(getLocalizedPathFor(Astro.url.pathname, 'en'), siteUrl)} />
    <link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPathFor(Astro.url.pathname, 'es'), siteUrl)} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'es' ? 'es_PE' : 'en_US'} />
    <meta property="og:image" content={new URL(image, siteUrl)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={new URL(image, siteUrl)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Apply the saved preference before the first paint to avoid a theme flash. -->
    <script is:inline>
      (() => {
        let storedTheme;
        try { storedTheme = localStorage.getItem('theme'); } catch {}
        document.documentElement.classList.toggle('dark', storedTheme === 'dark');
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
